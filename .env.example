# Copy this file to .env for local development.
# Never commit .env; it is intentionally listed in .gitignore.

# Required once the app starts making real model calls.
# Create an API key at https://platform.openai.com/api-keys and paste it into your local .env file only.
OPENAI_API_KEY=your-openai-api-key-here

# Optional OpenAI-compatible provider settings.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional running-summary model. This can be cheaper/smaller than the main model.
AGENT_SUMMARY_MODEL=gpt-4.1-mini

# Optional context-window and summary limits before each model call.
AGENT_MAX_CONTEXT_MESSAGES=40
AGENT_MAX_MESSAGE_CHARS=8000
AGENT_MAX_TOOL_RESULT_CHARS=4000
AGENT_MAX_SUMMARY_CHARS=2000
AGENT_SUMMARY_MAX_INPUT_MESSAGES=10
